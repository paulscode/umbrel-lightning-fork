#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require("../app");
var debug = require("debug")("nodejs-regular-webapp2:server");
var http = require("http");

const configLogic = require("logic/config");
const lndLogic = require('logic/lightning');
const constants = require("utils/const");

/**
 * Update umbrel-lnd.conf if it is out-of-date. On StartOS the package owns
 * lnd.conf and restarts LND itself, so the dashboard touches neither; it
 * refuses to start without a password instead, because nothing else would
 * stand between the network and the wallet.
 */

const platform = process.env.DASHBOARD_PLATFORM;
if (platform !== undefined && platform !== "umbrel" && platform !== "startos") {
  console.error(`DASHBOARD_PLATFORM=${platform} is not a platform this dashboard knows; refusing to guess.`);
  process.exit(1);
}
if (constants.IS_STARTOS) {
  if (!constants.DASHBOARD_PASSWORD && !constants.DASHBOARD_PASSWORD_FILE) {
    console.error("DASHBOARD_PLATFORM=startos needs DASHBOARD_PASSWORD or DASHBOARD_PASSWORD_FILE; refusing to serve the wallet without one.");
    process.exit(1);
  }
} else {
  (async () => {
    const config = await configLogic.getConfig();

    if(! await configLogic.isUmbrelLndConfUpToDate(config)) {
      console.log('lnd config is not up to date, generating new config...');

      // set tor.skip-proxy-for-clearnet-targets to false for existing installs that are just now getting hybrid mode support
      if (constants.LND_INITIALIZE_WITH_TOR_ONLY) config['tor.skip-proxy-for-clearnet-targets'] = false;

      await configLogic.writeLndConfig(config);
      await lndLogic.restartLndWithRetries();
    }
  })();
}

/**
 * Stop the channel backup agent and the listener on a signal, then leave:
 * a listener that stays would make the process wait out docker's grace
 * period and end in a kill.
 */
const channelBackup = require("logic/channelBackup");
for (const signal of ["SIGTERM", "SIGINT"]) {
  process.once(signal, () => {
    channelBackup.stopWatcher();
    if (typeof server !== "undefined") {
      server.close();
    }
    if (mobileServer) {
      mobileServer.close();
    }
    setTimeout(() => process.exit(0), 500).unref();
  });
}

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || "3006");
app.set("port", port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

/**
 * The mobile API's own TLS listener, where no proxy in front of the app
 * terminates TLS (Umbrel). It serves the mobile API and nothing else.
 */

var mobileServer;
if (process.env.MOBILE_TLS_PORT) {
  const https = require("https");
  const access = require("logic/mobileAccess.js");
  // The names a phone is told to use. A client that checks names as well
  // as the pinned root (the app checks the root, and accepts the node's own
  // addresses) finds them here.
  const names = [
    process.env.DEVICE_DOMAIN_NAME,
    process.env.MOBILE_ONION,
    process.env.MOBILE_LAN_IP,
    "localhost",
  ].filter(Boolean);
  // A problem here costs the phones, not the dashboard.
  try {
    const tls = access.ensureServerCert(names);
    mobileServer = https.createServer({ key: tls.key, cert: tls.cert, minVersion: "TLSv1.2" }, require("../mobileApp"));
    // A slow or stalled client may hold a socket only so long.
    mobileServer.requestTimeout = 180000;
    mobileServer.headersTimeout = 30000;
    mobileServer.listen(normalizePort(process.env.MOBILE_TLS_PORT));
    mobileServer.on("listening", () => {
      console.log("Mobile API listening on port " + process.env.MOBILE_TLS_PORT);
    });
    mobileServer.on("error", (error) => {
      console.error("Mobile API listener: " + error.message);
      access.setListenerProblem(error.message);
    });
    // The server certificate is reissued before it expires, without a
    // restart; the authority the phones pin stays the same.
    setInterval(() => {
      try {
        const fresh = access.ensureServerCert(names);
        mobileServer.setSecureContext({ key: fresh.key, cert: fresh.cert, minVersion: "TLSv1.2" });
      } catch (error) {
        console.error("Mobile API certificate: " + error.message);
      }
    }, 24 * 60 * 60 * 1000).unref();
  } catch (error) {
    console.error("Mobile API not started: " + error.message);
    access.setListenerProblem(error.message);
    mobileServer = undefined;
  }
}

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(bind + " requires elevated privileges");
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(bind + " is already in use");
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
  debug("Listening on " + bind);
  console.log("Listening on " + bind);
}
